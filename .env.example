# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-new-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,host.docker.internal,web

# --- PostgreSQL + PGVector ---
DB_USER=postgres
DB_NAME=documentdb
DB_PASSWORD=change-me
# Host/port the APP connects to. Inside docker compose this is overridden to
# db:5432 — the host port only needs to be free on your machine.
DB_HOST=localhost
DB_PORT=5433

# --- Ollama (Phase 1) ---
# Runs as the `ollama` compose service. This value is for host access via the
# published port; compose overrides it to http://ollama:11434 inside the network.
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b
EMBEDDING_DIM=768

# --- Arize Phoenix (Phase 5) ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- RAG pipeline (Block B) ---
# Which strategy answers questions: the CrewAI crew (true) or the plain
# LlamaIndex query engine (false). Default false: on this CPU host the crew
# takes ~200s per question and the 3b model is an unreliable tool-caller.
# Set true on GPU hardware to use the multi-agent path.
RAG_USE_CREW=false

# Layers to offload to the GPU. Leave unset to let Ollama decide.
# Set to 0 to force CPU-only, which is FASTER when the GPU is too small to hold
# the whole model - partial offload makes every token cross PCIe.
#OLLAMA_NUM_GPU=0
